{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immersion Dashboard",
  "version": "1.3.0",
  "identifier": "io.github.immersion-dashboard",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "旅の記録 · Immersion Dashboard", "width": 1280, "height": 900, "minWidth": 360, "minHeight": 500 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNjdDRkIzRTlGRTFFNTIKUldSU0h2N3BzODlub253Ym5leVV4R3B4bEFKOUhTM1RqcURyY2dTYmo4Z2w0Z1RlR041dHpQVGgK",
      "endpoints": ["https://github.com/mattias/immersion-dashboard/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
